[
  {
    "name": "ui: all components",
    "path": "packages/ui/src/index.ts",
    "import": "*",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "45 kB"
  },
  {
    "name": "ui: Button only (tree-shaking)",
    "path": "packages/ui/src/index.ts",
    "import": "{ Button }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "11 kB"
  },
  {
    "name": "tokens: tokens.css",
    "path": "packages/tokens/dist/tokens.css",
    "limit": "3.5 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: entry JS",
    "path": "apps/web/dist/assets/index-*.js",
    "limit": "110 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: theme knobs chunk (lazy)",
    "path": "apps/web/dist/assets/theme-knobs-page-*.js",
    "limit": "10 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: CSS",
    "path": "apps/web/dist/assets/*.css",
    "limit": "8 kB",
    "rolldown": false
  }
]
