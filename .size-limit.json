[
  {
    "name": "ui: all components",
    "path": "packages/ui/src/index.ts",
    "import": "*",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "45 kB"
  },
  {
    "name": "ui: Button only (tree-shaking)",
    "path": "packages/ui/src/index.ts",
    "import": "{ Button }",
    "ignore": [
      "react",
      "react-dom"
    ],
    "limit": "11 kB"
  },
  {
    "name": "tokens: tokens.css",
    "path": "packages/tokens/dist/tokens.css",
    "limit": "3.5 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: entry JS",
    "path": "apps/web/dist/assets/index-*.js",
    "limit": "65 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: design system chunk (shared by landing and docs)",
    "path": "apps/web/dist/assets/design-system-*.js",
    "limit": "46 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: landing chunk (lazy)",
    "path": "apps/web/dist/assets/landing-page-*.js",
    "limit": "6 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: docs chunk (lazy)",
    "path": "apps/web/dist/assets/docs-app-*.js",
    "limit": "6 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: theme knobs chunk (lazy)",
    "path": "apps/web/dist/assets/theme-knobs-page-*.js",
    "limit": "10 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: theme colour maths (lazy, shared by theme knobs and the landing brand picker)",
    "path": "apps/web/dist/assets/knobs-*.js",
    "limit": "7 kB",
    "rolldown": false
  },
  {
    "name": "apps/web: CSS",
    "path": "apps/web/dist/assets/*.css",
    "limit": "8.2 kB",
    "rolldown": false
  }
]
