{
  "radius": {
    "$type": "dimension",
    "inner": {
      "$value": "calc({theme.radius} * 0.5)",
      "$description": "Small elements inside controls, such as checkboxes."
    },
    "control": {
      "$value": "calc({theme.radius} * 0.75)"
    },
    "surface": {
      "$value": "{theme.radius}"
    },
    "pill": {
      "$value": "{radius.full}"
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": "{theme.font.body}"
    },
    "display": {
      "$type": "fontFamily",
      "$value": "{theme.font.display}"
    },
    "code": {
      "$type": "fontFamily",
      "$value": "{theme.font.mono}"
    }
  },
  "elevation": {
    "$type": "shadow",
    "raised": {
      "$value": "{shadow.sm}"
    },
    "floating": {
      "$value": "{shadow.md}"
    },
    "overlay": {
      "$value": "{shadow.lg}"
    }
  },
  "focus-ring": {
    "width": {
      "$type": "dimension",
      "$value": "{border-width.thick}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "{border-width.thick}"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.fast}"
      },
      "normal": {
        "$value": "{duration.normal}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}"
      }
    }
  }
}
