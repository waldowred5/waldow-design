  "theme": {
    "radius": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$description": "The one radius knob. Surfaces use it as is; controls and inner elements are fractions of it. 0 gives square corners everywhere."
    },
    "font": {
      "$type": "fontFamily",
      "body": {
        "$value": "{font-family.sans}"
