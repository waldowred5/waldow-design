{
  "font-family": {
    "sans": {
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "display": {
      "$value": [
        "Bricolage Grotesque Variable",
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$description": "The brand's display face (variable, with an optical-size axis), loaded by @waldow-design/ui/styles.css."
    },
    "mono": {
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": "0.75rem"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "md": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.125rem"
    },
    "xl": {
      "$value": "1.25rem"
    },
    "2xl": {
      "$value": "1.5rem"
    },
    "3xl": {
      "$value": "1.875rem"
    },
    "4xl": {
      "$value": "2.25rem"
    },
    "5xl": {
      "$value": "3rem"
    },
    "6xl": {
      "$value": "3.75rem"
    },
    "7xl": {
      "$value": "4.5rem",
      "$description": "Display sizes (5xl-7xl) are for heroes and landing titles, not headings in running text."
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    },
    "bold": {
      "$value": 700
    }
  },
  "line-height": {
    "none": {
      "$value": 1
    },
    "tight": {
      "$value": 1.2
    },
    "snug": {
      "$value": 1.375
    },
    "normal": {
      "$value": 1.5
    }
  }
}
